# Cloud models are auto-detected if pulled via: task ollama:pull
# Link your device at https://ollama.com/settings first
#   Vision/spatial: qwen3-vl:235b-cloud
#   Text: deepseek-v3.1:671b-cloud

# Override default models
# OLLAMA_VISION_MODEL=llava:7b
# OLLAMA_TEXT_MODEL=llama3.2:3b
# OLLAMA_SPATIAL_MODEL=qwen3-vl:8b-thinking
# OLLAMA_CLOUD_TEXT_MODEL=deepseek-v3.1:671b-cloud

# Service URLs
# OLLAMA_URL=http://localhost:11434
# DATABASE_URL=postgres://postgres:postgres@localhost:15433/gothreads?sslmode=disable
# REMBG_URL=http://localhost:5000
# Virtual try-on backends (optional)
# CATVTON_LOCAL_URL=http://localhost:8557  # Local CatVTON for clothing (GPU accelerated with ROCm)
# LADIVTON_SHOES_URL=http://localhost:8558  # LaDI-VTON-Shoes for footwear try-on
